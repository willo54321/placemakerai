# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/placemaker

# NextAuth: JWT signing secret (generate with `openssl rand -base64 32`) and base URL
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3002

# Google Maps JavaScript API key (client-side; maps render blank without it)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Resend email delivery for account emails (invite / password reset)
RESEND_API_KEY=
EMAIL_FROM="Placemaker.ai <noreply@placemakerai.io>"

# Anthropic key for AI feedback analysis (analysis endpoints error without it).
# ANTHROPIC_WORKSPACE_ID is required only for identity-linked keys.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Vercel Blob storage for image uploads (overlays). Uploads fall back to
# base64 data URLs (<3MB) when unset.
BLOB_READ_WRITE_TOKEN=
