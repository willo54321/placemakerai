# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/placemaker

# NextAuth: JWT signing secret (generate with `openssl rand -base64 32`) and base URL
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3002

# Google Maps JavaScript API key (client-side; maps render blank without it)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Resend email delivery. EMAIL_FROM is the default from address when a project
# has no verified sending domain configured.
RESEND_API_KEY=
EMAIL_FROM="Placemaker.ai <noreply@placemakerai.io>"

# Shared secret the inbound-email webhook (Cloudflare worker) must present as
# a Bearer token. Inbound email is rejected if unset.
EMAIL_WEBHOOK_SECRET=

# OpenAI key for AI feedback analysis (analysis endpoints error without it)
OPENAI_API_KEY=

# Vercel Blob storage for image uploads (overlays). Uploads fall back to
# base64 data URLs (<3MB) when unset.
BLOB_READ_WRITE_TOKEN=
