{
  "name": "consultation-platform",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start -p 3002",
    "lint": "eslint src",
    "db:dev": "node scripts/dev-db.mjs",
    "db:seed": "node scripts/seed-dev.mjs",
    "db:push": "prisma db push",
    "db:push:staging": "set -a && . ./.env.staging && set +a && prisma db push",
    "db:push:prod": "set -a && . ./.env.prod && set +a && prisma db push",
    "seed:untypical:prod": "set -a && . ./.env.prod && set +a && npx tsx prisma/seed-untypical.ts",
    "db:backup:prod": "set -a && . ./.env.prod && set +a && mkdir -p backups && pg_dump \"$DATABASE_URL\" -Fc -f \"backups/prod-$(date +%Y%m%d-%H%M%S).dump\"",
    "db:studio": "prisma studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.9.0",
    "@react-google-maps/api": "^2.20.8",
    "@sentry/nextjs": "^10.72.0",
    "@tanstack/react-query": "^5.17.0",
    "@turf/turf": "^7.3.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^3.0.3",
    "date-fns": "^3.3.0",
    "framer-motion": "^13.1.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "next-auth": "^4.24.13",
    "node-html-parser": "^7.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.2.3",
    "recharts": "^3.6.0",
    "resend": "^6.7.0",
    "shpjs": "^6.2.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.17",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.4.33",
    "prisma": "^5.9.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  }
}
