generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Council {
  id             String       @id @default(cuid())
  name           String       @unique
  mapitName      String?
  gssCode        String?
  type           String
  website        String?
  councillorsUrl String?
  scraperType    String?
  lastScraped    DateTime?
  scrapeStatus   String       @default("pending")
  scrapeError    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  councillors    Councillor[]

  @@index([gssCode])
  @@index([mapitName])
}

model Councillor {
  id            String   @id @default(cuid())
  councilId     String
  name          String
  title         String?
  firstName     String?
  lastName      String?
  party         String?
  wardName      String
  wardMapitName String?
  email         String?
  phone         String?
  profileUrl    String?
  photoUrl      String?
  cabinetRole   String?
  committees    String?
  source        String   @default("scrape")
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  council       Council  @relation(fields: [councilId], references: [id], onDelete: Cascade)

  @@unique([councilId, wardName, name])
  @@index([wardMapitName])
  @@index([wardName])
}

model Enquiry {
  id              String    @id @default(cuid())
  projectId       String
  submitterName   String
  submitterEmail  String
  submitterPhone  String?
  submitterOrg    String?
  subject         String
  message         String
  category        String    @default("general")
  gdprConsent     Boolean   @default(false)
  gdprConsentDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model FeedbackForm {
  id        String             @id @default(cuid())
  projectId String
  name      String
  fields    Json
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  Project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responses FeedbackResponse[]

  @@index([projectId])
}

model FeedbackResponse {
  id              String       @id @default(cuid())
  formId          String
  data            Json
  submittedAt     DateTime     @default(now())
  gdprConsent     Boolean      @default(false)
  gdprConsentDate DateTime?
  form            FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

model GeoLayer {
  id        String   @id @default(cuid())
  projectId String
  name      String
  type      String   @default("boundary")
  geojson   Json
  style     Json?
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ImageOverlay {
  id        String   @id @default(cuid())
  projectId String
  name      String
  imageUrl  String
  southLat  Float
  westLng   Float
  northLat  Float
  eastLng   Float
  opacity   Float    @default(0.7)
  rotation  Float    @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Invitation {
  id             String       @id @default(cuid())
  email          String
  organizationId String
  role           String       @default("member")
  token          String       @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}

model MapMarker {
  id        String   @id @default(cuid())
  projectId String
  label     String
  type      String   @default("point")
  latitude  Float?
  longitude Float?
  color     String   @default("#3B82F6")
  icon      String?
  notes     String?
  createdAt DateTime @default(now())
  geometry  Json?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Organization {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  plan             String               @default("free")
  stripeCustomerId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  invitations      Invitation[]
  members          OrganizationMember[]
  projects         Project[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("member")
  joinedAt       DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Project {
  id                    String           @id @default(cuid())
  name                  String
  description           String?
  latitude              Float?
  longitude             Float?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  mapZoom               Int?             @default(10)
  embedEnabled          Boolean          @default(false)
  allowPins             Boolean          @default(true) // Allow visitors to drop pins/comments
  allowDrawing          Boolean          @default(false) // Allow visitors to draw shapes
  organizationId        String?
  // Embed styling customization
  embedPrimaryColor     String? // Primary color for buttons/accents (hex)
  embedFontFamily       String? // Font family (google fonts name)
  embedHideStreetLabels Boolean          @default(false) // Hide street labels on map
  embedReferenceOnly    Boolean          @default(false) // Reference mode - no interactions, view only
  embedDefaultSatellite Boolean          @default(false) // Default to satellite view instead of roadmap
  enquiries             Enquiry[]
  feedbackForms         FeedbackForm[]
  geoLayers             GeoLayer[]
  imageOverlays         ImageOverlay[]
  mapMarkers            MapMarker[]
  organization          Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publicPins            PublicPin[]
  analysisResults       AnalysisResult[]
  userAccess            ProjectAccess[]
}

model PublicPin {
  id              String    @id @default(cuid())
  projectId       String
  latitude        Float?
  longitude       Float?
  category        String    @default("comment")
  comment         String
  name            String?
  email           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  votes           Int       @default(0)
  approved        Boolean   @default(false)
  geometry        Json?
  shapeType       String    @default("pin")
  gdprConsent     Boolean   @default(false)
  gdprConsentDate DateTime?
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  voteRecords     PinVote[]

  @@index([projectId, approved])
  @@index([projectId, createdAt])
}

model PinVote {
  id        String    @id @default(cuid())
  pinId     String
  voterHash String
  createdAt DateTime  @default(now())
  pin       PublicPin @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@unique([pinId, voterHash])
  @@index([pinId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SystemRole {
  SUPER_ADMIN
  USER
}

enum ProjectRole {
  ADMIN
  CLIENT
}

model User {
  id                      String               @id @default(cuid())
  name                    String?
  email                   String               @unique
  emailVerified           DateTime?
  image                   String?
  password                String?
  // Set-password / reset flow: emailed on invite and on "forgot password"
  passwordResetToken      String?              @unique
  passwordResetExpires    DateTime?
  systemRole              SystemRole           @default(USER)
  // Show the dashboard product tour on next sign-in; user can opt out via
  // "don't show again", super admins can re-enable per user.
  showTour                Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  accounts                Account[]
  invitations             Invitation[]
  organizationMemberships OrganizationMember[]
  sessions                Session[]
  projectAccess           ProjectAccess[]
}

model ProjectAccess {
  id        String      @id @default(cuid())
  userId    String
  projectId String
  role      ProjectRole @default(CLIENT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AnalysisResult {
  id           String   @id @default(cuid())
  projectId    String
  type         String // "sentiment" | "themes" | "summary" | "full"
  data         Json // Analysis results (last completed analysis; {} before the first completes)
  feedbackHash String // Hash of feedback to detect changes
  status       String   @default("complete") // "processing" | "finalizing" | "complete" | "failed"
  batchId      String? // Anthropic Batch API id while a run is in flight
  pending      Json? // PendingAnalysis state needed to finalize a batch
  error        String? // Failure reason when status = "failed"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@index([projectId])
}
